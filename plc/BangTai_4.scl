// ============================================================================
//  FC: Bang_Tai_4  -  Dieu khien 4 bang tai van chuyen Pallet 2 chieu
//  - Tach hang (accumulation): zone chi day khi zone ke tiep trong
//  - Chuoi an toan nut khan (NC noi tiep)
//  - DA BO CUA NANG (tuyen chi con 4 bang noi tiep)
//  Tuong duong 1:1 voi ban Ladder trong BangTai_4_LadderLogic.md
//  Platform: Siemens S7-1200/1500 (TIA Portal).
//  Cach dung: External source files -> Add -> Generate blocks from source.
// ============================================================================

// === N1: Chuoi an toan (4 nut khan NC noi tiep) ===
"Safety_OK" := "EMG_L1" AND "EMG_L2" AND "EMG_R1" AND "EMG_R2";

// === N2/N3: Gom nut Thuan / Nghich ===
"FWD_PB" := "PB_L1_FWD" OR "PB_L2_FWD" OR "PB_R1_FWD" OR "PB_R2_FWD";
"REV_PB" := "PB_L1_REV" OR "PB_L2_REV" OR "PB_R1_REV" OR "PB_R2_REV";

// === N4: Toan tuyen trong ===
"Line_Empty" := NOT ("S1A" OR "S1B" OR "S2A" OR "S2B"
                  OR "S3A" OR "S3B" OR "S4A" OR "S4B");

// === N5: Chiem cho tung bang ===
"Occ1" := "S1A" OR "S1B";
"Occ2" := "S2A" OR "S2B";
"Occ3" := "S3A" OR "S3B";
"Occ4" := "S4A" OR "S4B";

// === N6: Khoa che do THUAN (seal-in) ===
"FWD_Mode" := (("FWD_PB" AND "S1A" AND NOT "REV_Mode") OR "FWD_Mode")
              AND "Safety_OK" AND NOT "Line_Empty";

// === N7: Khoa che do NGHICH (seal-in) ===
"REV_Mode" := (("REV_PB" AND "S4B" AND NOT "FWD_Mode") OR "REV_Mode")
              AND "Safety_OK" AND NOT "Line_Empty";

// === N8..N11: Release chieu THUAN ===
"REL1F" := "FWD_Mode" AND "Occ1" AND NOT "Occ2";
"REL2F" := "FWD_Mode" AND "Occ2" AND NOT "Occ3";
"REL3F" := "FWD_Mode" AND "Occ3" AND NOT "Occ4";
"REL4F" := "FWD_Mode" AND "Occ4";                       // xa ra ngoai

// === N12..N15: Release chieu NGHICH ===
"REL4R" := "REV_Mode" AND "Occ4" AND NOT "Occ3";
"REL3R" := "REV_Mode" AND "Occ3" AND NOT "Occ2";
"REL2R" := "REV_Mode" AND "Occ2" AND NOT "Occ1";
"REL1R" := "REV_Mode" AND "Occ1";                       // xa ra ngoai

// === N16..N19: Ngo ra motor THUAN (nha ra HOAC nhan tu bang truoc) ===
"CV1_FWD" := "REL1F" AND "Safety_OK";
"CV2_FWD" := ("REL2F" OR "REL1F") AND "Safety_OK";
"CV3_FWD" := ("REL3F" OR "REL2F") AND "Safety_OK";
"CV4_FWD" := ("REL4F" OR "REL3F") AND "Safety_OK";

// === N20..N23: Ngo ra motor NGHICH ===
"CV4_REV" := "REL4R" AND "Safety_OK";
"CV3_REV" := ("REL3R" OR "REL4R") AND "Safety_OK";
"CV2_REV" := ("REL2R" OR "REL3R") AND "Safety_OK";
"CV1_REV" := ("REL1R" OR "REL2R") AND "Safety_OK";

// === N24: Den bao (tuy chon) ===
"Lamp_FWD" := "FWD_Mode";
"Lamp_REV" := "REV_Mode";
"Lamp_EMG" := NOT "Safety_OK";
