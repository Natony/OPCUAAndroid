// ============================================================================
//  FC: Bang_Tai_4  -  Dieu khien 4 bang tai van chuyen Pallet 2 chieu
//  - Tach hang (accumulation): pallet dung cho TAI cam bien cuoi bang neu bang ke ban
//  - CHOT hien dien pallet (Arr_i) -> KHONG dung o vung chet giua 2 cam bien
//  - Chuoi an toan nut khan (NC noi tiep). Cam bien NO (1 = co pallet).
//  Tuong duong 1:1 voi ban Ladder trong BangTai_4_LadderLogic.md
//  Cach dung: External source files -> Add -> Generate blocks from source.
// ============================================================================

// === N1: Chuoi an toan (4 nut khan NC noi tiep) ===
"Safety_OK" := "EMG_L1" AND "EMG_L2" AND "EMG_R1" AND "EMG_R2";

// === N2/N3: Gom nut Thuan / Nghich ===
"FWD_PB" := "PB_L1_FWD" OR "PB_L2_FWD" OR "PB_R1_FWD" OR "PB_R2_FWD";
"REV_PB" := "PB_L1_REV" OR "PB_L2_REV" OR "PB_R1_REV" OR "PB_R2_REV";

// === N4: Toan tuyen trong ===
"Line_Empty" := NOT ("S1A" OR "S1B" OR "S2A" OR "S2B"
                  OR "S3A" OR "S3B" OR "S4A" OR "S4B");

// === N5: Cam bien tuc thoi tung bang ===
"Occ1" := "S1A" OR "S1B";
"Occ2" := "S2A" OR "S2B";
"Occ3" := "S3A" OR "S3B";
"Occ4" := "S4A" OR "S4B";

// === N6: Khoa che do THUAN (seal-in) ===
"FWD_Mode" := (("FWD_PB" AND "S1A" AND NOT "REV_Mode") OR "FWD_Mode")
              AND "Safety_OK" AND NOT "Line_Empty";

// === N7: Khoa che do NGHICH (seal-in) ===
"REV_Mode" := (("REV_PB" AND "S4B" AND NOT "FWD_Mode") OR "REV_Mode")
              AND "Safety_OK" AND NOT "Line_Empty";

// === N8/N9: Co "da toi cam bien xa" (xac nhan da qua bang cuoi truoc khi nha chot) ===
IF "FWD_Mode" AND "S4B" THEN "PassedFwd4" := TRUE; END_IF;
IF NOT "Arr4"          THEN "PassedFwd4" := FALSE; END_IF;

IF "REV_Mode" AND "S1A" THEN "PassedRev1" := TRUE; END_IF;
IF NOT "Arr1"          THEN "PassedRev1" := FALSE; END_IF;

// === N10..N13: CHOT hien dien pallet Arr_i (giu qua vung chet) ===
//  SET khi co cam bien tren bang; RESET khi pallet DA sang bang ke / da xa ra ngoai.
IF "Occ1" THEN "Arr1" := TRUE; END_IF;
IF NOT "Occ1" AND (("FWD_Mode" AND "Occ2") OR ("REV_Mode" AND "PassedRev1"))
   THEN "Arr1" := FALSE; END_IF;

IF "Occ2" THEN "Arr2" := TRUE; END_IF;
IF NOT "Occ2" AND (("FWD_Mode" AND "Occ3") OR ("REV_Mode" AND "Occ1"))
   THEN "Arr2" := FALSE; END_IF;

IF "Occ3" THEN "Arr3" := TRUE; END_IF;
IF NOT "Occ3" AND (("FWD_Mode" AND "Occ4") OR ("REV_Mode" AND "Occ2"))
   THEN "Arr3" := FALSE; END_IF;

IF "Occ4" THEN "Arr4" := TRUE; END_IF;
IF NOT "Occ4" AND (("FWD_Mode" AND "PassedFwd4") OR ("REV_Mode" AND "Occ3"))
   THEN "Arr4" := FALSE; END_IF;

// === N14..N17: Ngo ra motor THUAN ===
//  Chay neu co pallet tren bang (Arr) va KHONG dang dung cho o cam bien cuoi vi bang ke ban.
"CV1_FWD" := "FWD_Mode" AND "Arr1" AND "Safety_OK" AND NOT ("S1B" AND "Occ2");
"CV2_FWD" := "FWD_Mode" AND "Arr2" AND "Safety_OK" AND NOT ("S2B" AND "Occ3");
"CV3_FWD" := "FWD_Mode" AND "Arr3" AND "Safety_OK" AND NOT ("S3B" AND "Occ4");
"CV4_FWD" := "FWD_Mode" AND "Arr4" AND "Safety_OK";              // bang xa

// === N18..N21: Ngo ra motor NGHICH ===
"CV4_REV" := "REV_Mode" AND "Arr4" AND "Safety_OK" AND NOT ("S4A" AND "Occ3");
"CV3_REV" := "REV_Mode" AND "Arr3" AND "Safety_OK" AND NOT ("S3A" AND "Occ2");
"CV2_REV" := "REV_Mode" AND "Arr2" AND "Safety_OK" AND NOT ("S2A" AND "Occ1");
"CV1_REV" := "REV_Mode" AND "Arr1" AND "Safety_OK";              // bang xa

// === N22: Den bao (tuy chon) ===
"Lamp_FWD" := "FWD_Mode";
"Lamp_REV" := "REV_Mode";
"Lamp_EMG" := NOT "Safety_OK";
